# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: URL de conexão com o PostgreSQL local ou em nuvem
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db"

# Na Vercel, use exatamente este nome com a URI PostgreSQL do Supabase Pooler.
# O valor deve iniciar com postgresql://; a URL HTTPS do projeto nao serve ao driver pg.
URL_SUPABASE="postgresql://USUARIO:SENHA@HOST_POOLER:6543/postgres"

# Nomes reservados no painel da Vercel. Nunca prefixar com VITE_.
# A arquitetura atual acessa o Supabase somente pelo backend e nao expoe estas chaves.
ANON_KEY_SUPABASE=""
SERVICE_ROLE_SUPABASE=""

# PGSCHEMA: Schema isolado usado pela aplicação
PGSCHEMA="vendas_de_bolo"

# Servidor local Vite + Express
HOST="127.0.0.1"
PORT="5188"

# Credenciais usadas somente para criar o primeiro administrador
ADMIN_INITIAL_USER="Admin"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_WITH_A_STRONG_PASSWORD"

# Segredo aleatório com no mínimo 32 caracteres para assinar o cookie administrativo
# Gere um valor exclusivo para produção e salve apenas nos Secrets da Vercel
ADMIN_SESSION_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"

# TELEGRAM_BOT_TOKEN: (Opcional) Token do Bot do Telegram para envio automatizado via Bot API
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: (Opcional) Chat ID para o bot entregar notificações de novos pedidos
TELEGRAM_CHAT_ID=""
